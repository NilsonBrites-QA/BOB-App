// ─────────────────────────────────────────────────────────────────────────────
// BOB — Big Odds Brasileirão • Prisma Schema
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Usuários (whitelist) ────────────────────────────────────────────────────

model User {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String   @unique
  name             String?
  role             UserRole @default(VIEWER)
  active           Boolean  @default(true)
  pushSubscription String?  @map("push_subscription") // JSON serializado
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum UserRole {
  ADMIN
  VIEWER

  @@map("user_role")
}

// ─── Temporada ───────────────────────────────────────────────────────────────

model Season {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year      Int      @unique
  league    String   @default("Brasileirao Serie A")
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  rounds    Round[]

  @@map("seasons")
}

// ─── Rodada ──────────────────────────────────────────────────────────────────

model Round {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId     String      @map("season_id") @db.Uuid
  number       Int
  status       RoundStatus @default(DRAFT)
  firstMatchAt DateTime?   @map("first_match_at")
  cutoffAt     DateTime?   @map("cutoff_at") // calculado: firstMatchAt - 1h
  deliveredAt  DateTime?   @map("delivered_at")
  notes        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  season       Season        @relation(fields: [seasonId], references: [id])
  anchors      Anchor[]
  variations   Variation[]
  memoryEvents MemoryEvent[]
  result       RoundResult?

  @@unique([seasonId, number])
  @@map("rounds")
}

enum RoundStatus {
  DRAFT     // em construção
  READY     // pronto para entrega
  DELIVERED // entregue ao usuário
  CLOSED    // resultado registrado

  @@map("round_status")
}

// ─── Âncora ──────────────────────────────────────────────────────────────────

model Anchor {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId   String    @map("round_id") @db.Uuid
  team      String
  opponent  String
  score     Float // 0–100
  reasons   Json      @default("[]") // string[]
  rank      Int // 1–4
  matchDate DateTime? @map("match_date")
  createdAt DateTime  @default(now()) @map("created_at")

  round     Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("anchors")
}

// ─── Variação ────────────────────────────────────────────────────────────────

model Variation {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId         String          @map("round_id") @db.Uuid
  code            String // V1, V2, V3, V4, V5
  title           String
  posture         String
  projectedOdd    Float           @map("projected_odd")
  gameCount       Int             @map("game_count")
  anchorsTogether Boolean         @map("anchors_together")
  summary         String          @db.Text
  status          VariationStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")

  round           Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  picks           Pick[]

  @@map("variations")
}

enum VariationStatus {
  ACTIVE     // variação ativa
  REVISED    // reanalise após novo dado
  SUPERSEDED // substituída por nova versão

  @@map("variation_status")
}

// ─── Pick (jogo dentro da variação) ──────────────────────────────────────────

model Pick {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variationId   String      @map("variation_id") @db.Uuid
  fixtureId     String?     @map("fixture_id") // ID na API-Football
  match         String      // "Flamengo x Palmeiras"
  result        PickResult
  odd           Float
  isAnchor      Boolean     @default(false) @map("is_anchor")
  position      Int         // ordem no bilhete
  actualResult  String?     @map("actual_result") // HOME | DRAW | AWAY
  correct       Boolean?    // null = não registrado; true/false = resultado conhecido
  createdAt     DateTime    @default(now()) @map("created_at")

  variation     Variation   @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@map("picks")
}

enum PickResult {
  HOME // 1
  DRAW // X
  AWAY // 2

  @@map("pick_result")
}

// ─── Evento de Memória ────────────────────────────────────────────────────────

model MemoryEvent {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId        String?     @map("round_id") @db.Uuid
  layer          MemoryLayer
  type           String // lineup, injury, form, result, etc.
  content        Json // dado bruto estruturado
  source         String? // nome da API de origem
  relevanceScore Float?      @map("relevance_score") // 0–1
  createdAt      DateTime    @default(now()) @map("created_at")

  round          Round?      @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@map("memory_events")
}

enum MemoryLayer {
  RAW        // dado bruto ingerido
  NORMALIZED // dado processado
  PATTERNS   // padrões identificados
  DECISIONS  // decisões e justificativas

  @@map("memory_layer")
}

// ─── Resultado da Rodada ─────────────────────────────────────────────────────

model RoundResult {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId           String   @unique @map("round_id") @db.Uuid
  variationPlayed   String?  @map("variation_played") // V1–V5 ou null
  stakePerVariation Decimal  @map("stake_per_variation") @db.Decimal(10, 2)
  totalStaked       Decimal  @map("total_staked") @db.Decimal(10, 2)
  grossReturn       Decimal  @default(0) @map("gross_return") @db.Decimal(12, 2)
  netReturn         Decimal  @default(0) @map("net_return") @db.Decimal(12, 2)
  hit               Boolean  @default(false)
  notes             String?  @db.Text
  registeredAt      DateTime @default(now()) @map("registered_at")

  round             Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("round_results")
}

// ─── Fase 12: Memória Profunda + ABQC ────────────────────────────────────────

/**
 * Snapshot dos pesos do motor de scoring após calibração de cada rodada.
 * Permite rastrear a evolução histórica dos pesos e alimentar o ABQC.
 */
model FactorWeight {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  season         Int
  round          Int

  // Pesos dos 10 fatores (somam ~100)
  tableContext   Decimal  @map("table_context")   @db.Decimal(5, 2)
  recentForm     Decimal  @map("recent_form")     @db.Decimal(5, 2)
  momentum       Decimal                           @db.Decimal(5, 2)
  homeAway       Decimal  @map("home_away")       @db.Decimal(5, 2)
  goalsXg        Decimal  @map("goals_xg")        @db.Decimal(5, 2)
  h2h            Decimal                           @db.Decimal(5, 2)
  absences       Decimal                           @db.Decimal(5, 2)
  calendar       Decimal                           @db.Decimal(5, 2)
  market         Decimal                           @db.Decimal(5, 2)
  motivation     Decimal                           @db.Decimal(5, 2)

  // Métricas da rodada que gerou este snapshot
  overallAccuracy  Decimal? @map("overall_accuracy")  @db.Decimal(5, 4)
  anchorAccuracy   Decimal? @map("anchor_accuracy")   @db.Decimal(5, 4)
  samples          Int?
  calibrationNotes String?  @map("calibration_notes") @db.Text

  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([season, round])
  @@map("factor_weights")
}

/**
 * Padrões condicionais emergentes — combinações de fatores que sistematicamente
 * acertam ou erram. Usado pelo Anti-Correlation Discovery (ABQC 12.6).
 */
model ConditionalPattern {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patternKey     String   @unique @map("pattern_key") // hash determinístico
  factors        String[]                              // fatores envolvidos
  condition      String   @db.Text                    // descrição legível

  occurrences    Int      @default(0)
  correct        Int      @default(0)

  isAntiCorr     Boolean  @default(false) @map("is_anti_corr")
  isSuppressed   Boolean  @default(false) @map("is_suppressed")
  lastSeenRound  Int?     @map("last_seen_round")
  lastSeenSeason Int?     @map("last_seen_season")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  @@map("conditional_patterns")
}

// ─── Sprint 4: Simulação Retroativa Cega ─────────────────────────────────────

/**
 * Resultado de uma rodada simulada pelo motor cego.
 * "Cego" = motor gerou previsões sem ver o resultado; depois comparamos com o real.
 * Armazenado APÓS o resultado da rodada ser conhecido (via backfill ou post-round).
 */
model SimulationResult {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  season             Int
  round              Int

  // Acurácia das âncoras
  anchorCount        Int      @default(0) @map("anchor_count")
  anchorsCorrect     Int      @default(0) @map("anchors_correct")

  // Acurácia geral (todos os picks de todas as variações)
  totalPicks         Int      @default(0) @map("total_picks")
  correctPicks       Int      @default(0) @map("correct_picks")

  // Detalhamento por variação [{code, picksTotal, picksCorrect, won, projectedOdd}]
  variationsJson     Json     @default("[]") @map("variations_json")

  // Maior odd projetada vs real (variação vencedora, se houver)
  bestOddProjected   Decimal? @map("best_odd_projected") @db.Decimal(12, 2)
  bestOddReal        Decimal? @map("best_odd_real")      @db.Decimal(12, 2)

  // Se selfCalibrate() já foi rodado para este resultado
  calibrated         Boolean  @default(false)

  simulatedAt        DateTime @default(now()) @map("simulated_at")
  notes              String?  @db.Text

  @@unique([season, round])
  @@map("simulation_results")
}

