// ─────────────────────────────────────────────────────────────────────────────
// BOB — Big Odds Brasileirão • Prisma Schema
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Usuários (whitelist) ────────────────────────────────────────────────────

model User {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String   @unique
  name             String?
  role             UserRole @default(VIEWER)
  active           Boolean  @default(true)
  pushSubscription String?  @map("push_subscription") // JSON serializado
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("users")
}

enum UserRole {
  ADMIN
  VIEWER

  @@map("user_role")
}

// ─── Temporada ───────────────────────────────────────────────────────────────

model Season {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year      Int      @unique
  league    String   @default("Brasileirao Serie A")
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  rounds    Round[]

  @@map("seasons")
}

// ─── Rodada ──────────────────────────────────────────────────────────────────

model Round {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId        String      @map("season_id") @db.Uuid
  number          Int
  status          RoundStatus @default(DRAFT)
  firstMatchAt    DateTime?   @map("first_match_at")
  cutoffAt        DateTime?   @map("cutoff_at") // calculado: firstMatchAt - 1h
  deliveredAt     DateTime?   @map("delivered_at")
  /// Timestamp em que a rodada foi congelada (DELIVERED). Após isso, picks/variations
  /// não podem ser modificados sem o admin clicar "Regenerar" (que cria nova versão).
  frozenAt        DateTime?   @map("frozen_at")
  /// Versão incremental da rodada. Cada regeneração pelo admin cria nova versão
  /// e marca a anterior como SUPERSEDED. Versão 1 é a entrega original.
  version         Int         @default(1)
  /// FK para a versão anterior desta rodada (quando foi regenerada).
  previousRoundId String?     @map("previous_round_id") @db.Uuid
  supersededAt    DateTime?   @map("superseded_at")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  season       Season        @relation(fields: [seasonId], references: [id])
  anchors      Anchor[]
  variations   Variation[]
  memoryEvents MemoryEvent[]
  result       RoundResult?
  previous     Round?        @relation("RoundVersion", fields: [previousRoundId], references: [id], onDelete: SetNull)
  successors   Round[]       @relation("RoundVersion")

  @@index([seasonId, number])
  @@map("rounds")
}

enum RoundStatus {
  DRAFT      // em construção
  READY      // pronto para entrega
  DELIVERED  // entregue ao usuário (CONGELADA — variações imutáveis)
  SUPERSEDED // substituída por nova versão (admin clicou "Regenerar")
  CLOSED     // resultado registrado

  @@map("round_status")
}

// ─── Âncora ──────────────────────────────────────────────────────────────────

model Anchor {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId   String    @map("round_id") @db.Uuid
  team      String
  opponent  String
  score     Float // 0–100
  reasons   Json      @default("[]") // string[]
  rank      Int // 1–4
  matchDate DateTime? @map("match_date")
  createdAt DateTime  @default(now()) @map("created_at")

  round     Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("anchors")
}

// ─── Variação ────────────────────────────────────────────────────────────────

model Variation {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId         String          @map("round_id") @db.Uuid
  code            String // V1, V2, V3, V4, V5
  title           String
  posture         String
  projectedOdd    Float           @map("projected_odd")
  gameCount       Int             @map("game_count")
  anchorsTogether Boolean         @map("anchors_together")
  summary         String          @db.Text
  status          VariationStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")

  round           Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  picks           Pick[]

  @@map("variations")
}

enum VariationStatus {
  ACTIVE     // variação ativa
  REVISED    // reanalise após novo dado
  SUPERSEDED // substituída por nova versão

  @@map("variation_status")
}

// ─── Pick (jogo dentro da variação) ──────────────────────────────────────────

model Pick {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variationId   String      @map("variation_id") @db.Uuid
  fixtureId     String?     @map("fixture_id") // ID na API-Football
  match         String      // "Flamengo x Palmeiras"
  result        PickResult
  odd           Float
  isAnchor      Boolean     @default(false) @map("is_anchor")
  position      Int         // ordem no bilhete
  actualResult  String?     @map("actual_result") // HOME | DRAW | AWAY
  correct       Boolean?    // null = não registrado; true/false = resultado conhecido
  createdAt     DateTime    @default(now()) @map("created_at")

  variation     Variation   @relation(fields: [variationId], references: [id], onDelete: Cascade)

  @@map("picks")
}

enum PickResult {
  HOME // 1
  DRAW // X
  AWAY // 2

  @@map("pick_result")
}

// ─── Evento de Memória ────────────────────────────────────────────────────────

model MemoryEvent {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId        String?     @map("round_id") @db.Uuid
  layer          MemoryLayer
  type           String // lineup, injury, form, result, etc.
  content        Json // dado bruto estruturado
  source         String? // nome da API de origem
  relevanceScore Float?      @map("relevance_score") // 0–1
  createdAt      DateTime    @default(now()) @map("created_at")

  round          Round?      @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@map("memory_events")
}

enum MemoryLayer {
  RAW        // dado bruto ingerido
  NORMALIZED // dado processado
  PATTERNS   // padrões identificados
  DECISIONS  // decisões e justificativas

  @@map("memory_layer")
}

// ─── Resultado da Rodada ─────────────────────────────────────────────────────

model RoundResult {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId           String   @unique @map("round_id") @db.Uuid
  variationPlayed   String?  @map("variation_played") // V1–V5 ou null
  stakePerVariation Decimal  @map("stake_per_variation") @db.Decimal(10, 2)
  totalStaked       Decimal  @map("total_staked") @db.Decimal(10, 2)
  grossReturn       Decimal  @default(0) @map("gross_return") @db.Decimal(12, 2)
  netReturn         Decimal  @default(0) @map("net_return") @db.Decimal(12, 2)
  hit               Boolean  @default(false)
  notes             String?  @db.Text
  registeredAt      DateTime @default(now()) @map("registered_at")

  round             Round    @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("round_results")
}

// ─── Fase 12: Memória Profunda + ABQC ────────────────────────────────────────

/**
 * Snapshot dos pesos do motor de scoring após calibração de cada rodada.
 * Permite rastrear a evolução histórica dos pesos e alimentar o ABQC.
 */
model FactorWeight {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  season         Int
  round          Int

  // Pesos dos 10 fatores (somam ~100)
  tableContext   Decimal  @map("table_context")   @db.Decimal(5, 2)
  recentForm     Decimal  @map("recent_form")     @db.Decimal(5, 2)
  momentum       Decimal                           @db.Decimal(5, 2)
  homeAway       Decimal  @map("home_away")       @db.Decimal(5, 2)
  goalsXg        Decimal  @map("goals_xg")        @db.Decimal(5, 2)
  h2h            Decimal                           @db.Decimal(5, 2)
  absences       Decimal                           @db.Decimal(5, 2)
  calendar       Decimal                           @db.Decimal(5, 2)
  market         Decimal                           @db.Decimal(5, 2)
  motivation     Decimal                           @db.Decimal(5, 2)

  // Métricas da rodada que gerou este snapshot
  overallAccuracy  Decimal? @map("overall_accuracy")  @db.Decimal(5, 4)
  anchorAccuracy   Decimal? @map("anchor_accuracy")   @db.Decimal(5, 4)
  samples          Int?
  calibrationNotes String?  @map("calibration_notes") @db.Text

  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([season, round])
  @@map("factor_weights")
}

/**
 * Padrões condicionais emergentes — combinações de fatores que sistematicamente
 * acertam ou erram. Usado pelo Anti-Correlation Discovery (ABQC 12.6).
 */
model ConditionalPattern {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patternKey     String   @unique @map("pattern_key") // hash determinístico
  factors        String[]                              // fatores envolvidos
  condition      String   @db.Text                    // descrição legível

  occurrences    Int      @default(0)
  correct        Int      @default(0)

  isAntiCorr     Boolean  @default(false) @map("is_anti_corr")
  isSuppressed   Boolean  @default(false) @map("is_suppressed")
  lastSeenRound  Int?     @map("last_seen_round")
  lastSeenSeason Int?     @map("last_seen_season")

  /**
   * Embedding semântico do padrão — vetor de 1536 dimensões (OpenAI text-embedding-3-small).
   * Permite busca por similaridade coseno (HNSW) na Memória Semântica do Cérebro.
   * Requer a extensão pgvector ativa no Supabase (migration 009_pgvector_embedding.sql).
   * Prisma usa Unsupported(): o campo existe no banco mas não é mapeado para TypeScript.
   * Queries de similarity search devem ser feitas via SQL raw ($queryRaw).
   */
  embedding      Unsupported("vector(1536)")?

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt      @map("updated_at")

  @@map("conditional_patterns")
}

// ─── Sprint 4: Simulação Retroativa Cega ─────────────────────────────────────

// ─── Memória de Chat ─────────────────────────────────────────────────────────

/**
 * Histórico de mensagens do chat por usuário.
 * TTL virtual de 4 dias: filtrar por WHERE created_at > NOW() - INTERVAL '4 days'
 * nas queries — não há trigger de deleção automática.
 */
model ChatMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   // "user" | "assistant"
  content   String   @db.Text
  model     String?  // "claude-sonnet" | "gpt-4o-mini" | "offline"
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("chat_messages")
}

// ─── Sprint 4: Simulação Retroativa Cega ─────────────────────────────────────

/**
 * Resultado de uma rodada simulada pelo motor cego.
 * "Cego" = motor gerou previsões sem ver o resultado; depois comparamos com o real.
 * Armazenado APÓS o resultado da rodada ser conhecido (via backfill ou post-round).
 */
model SimulationResult {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  season             Int
  round              Int

  // Acurácia das âncoras
  anchorCount        Int      @default(0) @map("anchor_count")
  anchorsCorrect     Int      @default(0) @map("anchors_correct")

  // Acurácia geral (todos os picks de todas as variações)
  totalPicks         Int      @default(0) @map("total_picks")
  correctPicks       Int      @default(0) @map("correct_picks")

  // Detalhamento por variação [{code, picksTotal, picksCorrect, won, projectedOdd}]
  variationsJson     Json     @default("[]") @map("variations_json")

  // Maior odd projetada vs real (variação vencedora, se houver)
  bestOddProjected   Decimal? @map("best_odd_projected") @db.Decimal(12, 2)
  bestOddReal        Decimal? @map("best_odd_real")      @db.Decimal(12, 2)

  // Se selfCalibrate() já foi rodado para este resultado
  calibrated         Boolean  @default(false)

  simulatedAt        DateTime @default(now()) @map("simulated_at")
  notes              String?  @db.Text

  @@unique([season, round])
  @@map("simulation_results")
}

// ─── Feature: Criar Aposta ────────────────────────────────────────────────────

model BetMatch {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  externalId   String         @unique @map("external_id")
  homeTeam     String         @map("home_team")
  awayTeam     String         @map("away_team")
  homeCrest    String?        @map("home_crest")
  awayCrest    String?        @map("away_crest")
  competition  String         // 'Serie A' | 'Serie B'
  season       Int
  round        Int?
  scheduledAt  DateTime       @map("scheduled_at")
  status       BetMatchStatus @default(SCHEDULED)
  homeScore    Int?           @map("home_score")
  awayScore    Int?           @map("away_score")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  odds         BetOdds[]
  suggestions  BobSuggestion[]
  selections   BetSelection[]

  @@index([competition, season, scheduledAt])
  @@map("bet_matches")
}

enum BetMatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED

  @@map("bet_match_status")
}

model BetOdds {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId     String    @map("match_id") @db.Uuid
  market      BetMarket
  option      String    // 'home' | 'draw' | 'away' | 'over_2.5' | 'btts_yes' | ...
  optionLabel String    @map("option_label")
  odd         Float
  isActive    Boolean   @default(true) @map("is_active")
  source      String?   // 'oddspapi' | 'manual'
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  match       BetMatch  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, market, option])
  @@map("bet_odds")
}

enum BetMarket {
  RESULT_1X2
  BTTS
  OVER_UNDER
  EXACT_SCORE
  DOUBLE_CHANCE
  ASIAN_HANDICAP
  FIRST_HALF_GOALS
  CORNERS
  CARDS

  @@map("bet_market")
}

model BetTicket {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  status          BetTicketStatus @default(DRAFT)
  stake           Decimal?        @db.Decimal(10, 2)
  totalOdds       Float?          @map("total_odds")
  potentialReturn Decimal?        @map("potential_return") @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  selections      BetSelection[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("bet_tickets")
}

enum BetTicketStatus {
  DRAFT
  PLACED
  WON
  LOST
  VOID

  @@map("bet_ticket_status")
}

model BetSelection {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId    String               @map("ticket_id") @db.Uuid
  matchId     String               @map("match_id") @db.Uuid
  market      BetMarket
  option      String
  optionLabel String               @map("option_label")
  odd         Float
  result      BetSelectionResult?
  createdAt   DateTime             @default(now()) @map("created_at")

  ticket      BetTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  match       BetMatch   @relation(fields: [matchId], references: [id])

  @@map("bet_selections")
}

enum BetSelectionResult {
  WON
  LOST
  VOID

  @@map("bet_selection_result")
}

model BobSuggestion {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId       String              @map("match_id") @db.Uuid
  profile       BettorProfile
  market        BetMarket
  option        String
  optionLabel   String              @map("option_label")
  odd           Float
  confidence    Float               // 0.0 a 1.0
  justification String              @db.Text
  isActive      Boolean             @default(true) @map("is_active")
  result        BetSelectionResult?
  createdAt     DateTime            @default(now()) @map("created_at")

  match         BetMatch            @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, profile, market])
  @@index([matchId])
  @@map("bob_suggestions")
}

/**
 * Análise LLM pré-computada das variações de uma rodada.
 *
 * Pré-computado via cron (1x/hora) → leitura O(1) no SSR.
 * Elimina latência de LLM no caminho do usuário.
 *
 * Campo `payload` (JSON) contém:
 *   - enrichments: Array<{ variationId, bobNarrative, keyInsight, riskAlerts, confidence }>
 *   - replacements (opcional): Array<{ variationId, fromMatchId, toMatchId, reason }>
 *
 * provider: "claude" | "gpt" | "gemini" | "heuristic"
 */
model VariationJudgement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  season    Int
  round     Int
  payload   Json
  provider  String
  tokensIn  Int?     @map("tokens_in")
  tokensOut Int?     @map("tokens_out")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([season, round])
  @@index([season, round])
  @@map("variation_judgements")
}

enum BettorProfile {
  CONSERVADOR
  MODERADO
  AGRESSIVO
  MATEMATICO

  @@map("bettor_profile")
}

// ─── Fase 1: Fundação — Assets de Times (TheSportsDB) ────────────────────────

/**
 * Cache permanente de assets visuais por time (logos, escudos, banners).
 * Fonte: TheSportsDB. Política DB-first absoluta.
 *
 * Regra PRD §9: "Sincronizado uma única vez e armazenado permanentemente."
 * NUNCA executar DELETE/TRUNCATE nesta tabela. Append-only.
 *
 * IDs cruzados (footballDataId, apiFootballId) permitem que o conector
 * index.ts resolva assets a partir de qualquer fonte primária.
 */
model TeamAsset {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// ID do time no TheSportsDB (ex: "133613") — chave de lookup primária
  tsdbId          String   @unique @map("tsdb_id")

  name            String
  shortName       String?  @map("short_name")

  /// URL do escudo/badge principal (strTeamBadge no TheSportsDB)
  logoUrl         String?  @map("logo_url")
  /// URL do logo alternativo (strTeamLogo)
  badgeUrl        String?  @map("badge_url")
  /// URL do banner em HD (strTeamBanner)
  bannerUrl       String?  @map("banner_url")

  stadiumName     String?  @map("stadium_name")
  stadiumThumb    String?  @map("stadium_thumb")
  country         String?

  /// ID no football-data.org — para matching cruzado de fontes
  footballDataId  Int?     @map("football_data_id")
  /// ID no API-Football — para matching cruzado de fontes
  apiFootballId   Int?     @map("api_football_id")

  /// Imutável: data da primeira e única sincronização com a API externa
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("team_assets")
}

// ─── BOB Bet Analyzer: Criar Aposta ────────────────────────────────────────

/**
 * Perfis de apostador para o BOB Bet Analyzer.
 * Define estratégias e ranges de odds para cada perfil.
 */
model BetProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique // 'conservador', 'moderado', 'agressivo', 'matematico'
  name        String
  description String?
  minOdd      Decimal  @map("min_odd") @db.Decimal(4, 2)
  maxOdd      Decimal  @map("max_odd") @db.Decimal(4, 2)
  riskLevel   String   @map("risk_level") // 'baixo', 'medio', 'alto', 'extremo'
  strategy    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  suggestions MarketSuggestion[]
  createdBets CreatedBet[]

  @@map("bet_profiles")
}

/**
 * Análise de partida pelo BOB Bet Analyzer.
 * Armazena probabilidades calculadas para cada mercado.
 */
model MatchAnalysis {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId             String   @map("match_id")
  season              Int
  round               Int
  homeTeam            String   @map("home_team")
  awayTeam            String   @map("away_team")
  scheduledAt         DateTime @map("scheduled_at")
  status              String   @default("pending") // 'pending', 'analyzing', 'completed', 'failed'

  // Probabilidades calculadas
  homeWinProbability  Decimal? @map("home_win_probability") @db.Decimal(5, 4)
  drawProbability     Decimal? @map("draw_probability") @db.Decimal(5, 4)
  awayWinProbability  Decimal? @map("away_win_probability") @db.Decimal(5, 4)
  bttsYesProbability  Decimal? @map("btts_yes_probability") @db.Decimal(5, 4)
  over25Probability   Decimal? @map("over_25_probability") @db.Decimal(5, 4)

  // Dados brutos e contexto
  rawData             Json?    @map("raw_data")
  analysisFactors     Json?    @map("analysis_factors")

  createdAt           DateTime @default(now()) @map("created_at")
  analyzedAt          DateTime? @map("analyzed_at")

  suggestions         MarketSuggestion[]
  createdBets         CreatedBet[]

  @@unique([matchId, season])
  @@index([season, round])
  @@index([status])
  @@map("match_analysis")
}

/**
 * Sugestões de apostas por mercado e perfil.
 * Cada sugestão é uma recomendação específica (ex: "Vitória do Flamengo @ 1.85").
 */
model MarketSuggestion {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  matchAnalysisId    String   @map("match_analysis_id") @db.Uuid
  matchAnalysis     MatchAnalysis @relation(fields: [matchAnalysisId], references: [id], onDelete: Cascade)

  profileId          String   @map("profile_id") @db.Uuid
  profile            BetProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  market             String   // '1x2', 'btts', 'over_under', 'correct_score', etc
  selection          String   // 'home', 'draw', 'away', 'yes', 'no', 'over_2.5', etc
  selectionLabel     String?  @map("selection_label")

  // Odds e probabilidades
  suggestedOdd       Decimal  @map("suggested_odd") @db.Decimal(6, 3)
  impliedProbability Decimal  @map("implied_probability") @db.Decimal(5, 4)
  calculatedProbability Decimal @map("calculated_probability") @db.Decimal(5, 4)
  expectedValue      Decimal? @map("expected_value") @db.Decimal(5, 4)

  // Qualidade
  confidenceScore    Int?     @map("confidence_score") // 0-100
  qualityRating      String?  @map("quality_rating") // 'A', 'B', 'C', 'D'

  // Justificativa da IA
  aiJustification    String?  @map("ai_justification") @db.Text
  aiFactors          Json?    @map("ai_factors")

  // Status
  isRecommended      Boolean  @default(false) @map("is_recommended")
  isPrimaryPick      Boolean  @default(false) @map("is_primary_pick")
  status             String   @default("active") // 'active', 'won', 'lost', 'void'

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([matchAnalysisId, profileId, market, selection])
  @@index([matchAnalysisId])
  @@index([profileId])
  @@index([isRecommended])
  @@map("market_suggestions")
}

/**
 * Apostas criadas (simples ou combinadas) por perfil.
 * Representa uma aposta completa pronta para o usuário.
 */
model CreatedBet {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  matchAnalysisId     String   @map("match_analysis_id") @db.Uuid
  matchAnalysis       MatchAnalysis @relation(fields: [matchAnalysisId], references: [id], onDelete: Cascade)

  profileId           String   @map("profile_id") @db.Uuid
  profile             BetProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  betType             String   @map("bet_type") // 'simples', 'combinada', 'criar_aposta'
  name                String?

  // Composição
  suggestionIds       Int[]    @map("suggestion_ids") // IDs das market_suggestions

  // Odds
  totalOdd            Decimal  @map("total_odd") @db.Decimal(8, 3)
  targetOdd           Decimal? @map("target_odd") @db.Decimal(6, 3)

  // Análise
  combinedProbability Decimal? @map("combined_probability") @db.Decimal(5, 4)
  expectedValue       Decimal? @map("expected_value") @db.Decimal(5, 4)
  confidenceLevel     Int?     @map("confidence_level") // 0-100

  // Explicação
  fullJustification   String?  @map("full_justification") @db.Text
  riskAssessment    String?  @map("risk_assessment") @db.Text

  // Resultado
  status              String   @default("pending") // 'pending', 'placed', 'won', 'lost', 'void'
  result              String?
  profitLoss          Decimal? @map("profit_loss") @db.Decimal(10, 2)

  createdAt           DateTime @default(now()) @map("created_at")
  resultedAt          DateTime? @map("resulted_at")

  @@index([matchAnalysisId])
  @@index([profileId])
  @@map("created_bets")
}

// ─── Fase 1: Fundação — Log de Sincronização de APIs ─────────────────────────

/**
 * Log imutável (Event Sourcing) de cada sincronização bem-sucedida com as
 * APIs externas. Implementa a camada L2 do cache-gate.ts.
 *
 * Este modelo é a fonte de verdade persistente para o `lastSyncedAt` que os
 * conectores passam ao cache-gate. A camada L1 (Map em memória no cache-gate)
 * é volátil; esta tabela garante continuidade entre cold starts de servidor.
 *
 * Regra PRD §9: imutabilidade de dados de aprendizado e contexto operacional.
 * NUNCA executar DELETE/TRUNCATE nesta tabela. Append-only.
 */
model ApiSyncLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /**
   * Fonte sincronizada. Valores permitidos:
   *   'thesportsdb' | 'football-data' | 'api-football' | 'oddspapi'
   * Constraint CHECK aplicada na migration SQL (Prisma não suporta CHECK nativamente).
   */
  source      String

  /**
   * Chave de cache no mesmo formato usado pelo cache-gate.ts.
   * Exemplos: "BSA-2026-standings", "fixtures-round-10", "lineups-fixture-123456"
   */
  cacheKey    String   @map("cache_key")

  /**
   * Janela da API-Football em que o sync ocorreu.
   * Nulo para TheSportsDB, football-data e OddsPapi.
   * Valores: 'T-48h' | 'T-24h' | 'T-1h'
   */
  windowLabel String?  @map("window_label")

  /**
   * Kickoff UTC do jogo-alvo — preenchido apenas para syncs de api-football.
   * Necessário ao cache-gate para calcular se a janela ainda é válida.
   */
  kickoffAt   DateTime? @map("kickoff_at")

  /// Data/hora UTC em que o sync foi realizado (= quando a resposta 2xx chegou)
  syncedAt    DateTime  @default(now()) @map("synced_at")

  /// HTTP status da resposta da API externa (200, 206, etc.)
  statusCode  Int?      @map("status_code")

  /// Número de registros retornados pela API nesta chamada
  recordCount Int?      @map("record_count")

  /// Contexto livre (ex: "Sinal interrompido — fallback ativo", "Janela T-1h")
  notes       String?   @db.Text

  @@index([source, cacheKey, windowLabel, syncedAt(sort: Desc)], name: "api_sync_log_lookup")
  @@map("api_sync_log")
}
